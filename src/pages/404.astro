---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Tobi-dev"
  description="That page could not be found. Head back to the Tobi-dev home page."
  noindex
>
  <section class="notfound">
    <h1>Page not found</h1>
    <p>The page you were after doesn't exist or has moved.</p>
    <p><a href="/">Back to home</a></p>
  </section>
</Base>

<style>
  .notfound {
    /* Horizontal gutters come from `main#main` (global.css); this only narrows
       the measure and adds its own vertical rhythm. */
    max-width: 40rem;
    margin-inline: auto;
    padding: 2rem 0;
    text-align: center;
  }
  .notfound h1 {
    font-size: 2rem;
    margin: 0 0 1rem;
  }
</style>
