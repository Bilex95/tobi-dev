---
// Home hero. Owns the page's single <h1>.
---

<section class="hero" aria-labelledby="hero-heading">
  <h1 id="hero-heading">Tobi-dev</h1>
  <p class="tagline">
    QA-automation and AI engineer — I build test tooling and CI pipelines that
    keep non-deterministic systems honest.
  </p>
  <p class="ctas">
    <a class="cta cta-primary" href="/case-studies/assertkit">
      Read the assertkit case study
    </a>
    <a class="cta cta-secondary" href="/work">See all work</a>
  </p>
</section>

<style>
  .hero {
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    margin: 0 0 0.75rem;
  }
  .tagline {
    max-width: 60ch;
    font-size: 1.125rem;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }
  .cta {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    border: 1px solid var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .cta-primary {
    background-color: var(--accent);
    color: var(--bg);
  }
  .cta-secondary {
    color: var(--accent);
  }
</style>
