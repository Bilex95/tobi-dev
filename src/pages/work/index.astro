---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { loadProjects } from '../../lib/github.ts';

const projects = await loadProjects({ token: import.meta.env.GITHUB_TOKEN });
const tags = [...new Set(projects.flatMap((p) => p.topics))].filter((t) => t !== 'portfolio').sort();
---

<Base title="Work — Tobi-dev" description="Projects and experiments in QA automation and AI.">
  <h1>Work</h1>
  <TagFilter tags={tags} />
  <h2 class="visually-hidden">Projects</h2>
  <div class="grid">
    {projects.map((p) => (
      <div data-project data-tags={p.topics.join(' ')}><ProjectCard project={p} /></div>
    ))}
  </div>
</Base>

<style>
  /* Scoped is fine here: this page has no component test, so the test ESM
     loader never has to resolve the CSS import a scoped block emits. (The
     `.card` / `.tag-filter` rules those components need live in global.css.) */
  h1 {
    font-size: 2rem;
    margin: 0;
  }

  /* Same track sizing as the home page's featured grid. */
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
</style>
