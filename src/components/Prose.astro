---
/**
 * Prose — wraps long-form rendered MDX in a `.prose` container with
 * typographic rhythm tuned to the site theme tokens.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 68ch;
    color: var(--fg);
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    scroll-margin-top: 5rem;
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
    scroll-margin-top: 5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1rem;
  }

  .prose :global(li) {
    margin-block: 0.35rem;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(code) {
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>
