---
import type { CollectionEntry } from 'astro:content';
import Prose from '../components/Prose.astro';
import { formatDate, isoDate } from '../lib/format.ts';

interface Props {
  data: CollectionEntry<'blog'>['data'];
}

const { data } = Astro.props;
const iso = isoDate(data.date);
const formatted = formatDate(data.date);
---

<article class="post">
  <header class="post__head">
    <h1>{data.title}</h1>
    <p class="post__date"><time datetime={iso}>{formatted}</time></p>
  </header>

  <Prose>
    <slot />
  </Prose>
</article>

<style>
  .post {
    max-width: 72rem;
    margin-inline: auto;
    padding: 2rem 1rem 4rem;
  }

  .post__head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .post__date {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.5rem 0 0;
  }
</style>
