---
import Base from '../../layouts/Base.astro';
import { loadProjects } from '../../lib/github.ts';
import type { Project } from '../../lib/github.ts';
import { formatDate } from '../../lib/format.ts';

export async function getStaticPaths() {
  const projects = await loadProjects({ token: import.meta.env.GITHUB_TOKEN });
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const updated = formatDate(new Date(project.pushedAt));
const tags = project.topics.filter((t) => t !== 'portfolio');
---

<Base title={`${project.name} — Tobi-dev`} description={project.description}>
  <article class="project">
    <p><a href="/work">← Back to work</a></p>
    <h1>{project.name}</h1>
    {project.blurb && <p class="blurb">{project.blurb}</p>}
    <p>{project.description}</p>
    <ul class="tags" aria-label="Tech tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
    <p class="meta">Last updated <time datetime={project.pushedAt}>{updated}</time></p>
    <p class="links">
      <a href={project.url}>Code</a>
      {project.homepage && <a href={project.homepage}>Live</a>}
    </p>
  </article>
</Base>

<style>
  /* Scoped is fine here: no component test renders this page, so the test ESM
     loader never has to resolve the CSS import a scoped block emits. */
  .project {
    /* Readable measure inside the shared `main#main` container (global.css). */
    max-width: 60rem;
  }

  .project h1 {
    font-size: 2rem;
    margin: 0.5rem 0 0;
  }

  .blurb {
    color: var(--fg);
    font-size: 1.1rem;
    max-width: 60ch;
    margin: 1rem 0 0;
  }

  .project > p {
    max-width: 60ch;
  }

  /* Same pills as `.case-study__stack li` and the project cards. */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 0;
  }

  .tags li {
    border: 1px solid var(--border);
    background-color: var(--card);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 1.25rem 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
