---
/**
 * AsciinemaPlayer — placeholder for a terminal recording.
 *
 * v1 ships no cast files, so this renders a single static <figure> poster and
 * loads no JavaScript. The vendored asciinema-player bundle and the cast
 * detection that went with it were removed in Task 6 rather than shipping
 * ~200KB of dead weight to every visitor.
 *
 * To bring the real player back: restore the vendored player under
 * public/vendor/asciinema/, detect casts with import.meta.glob over
 * src/assets/casts/*.cast, and lazy-load the player in a <script is:inline>
 * (the `is:inline` matters — the loader reads data-* attributes off the mount
 * and must not be bundled or deferred away from it).
 */
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<figure class="asciinema asciinema--empty" data-cast-src={src}>
  <div class="asciinema__poster" role="img" aria-label={`Terminal recording placeholder: ${title}`}>
    <p class="asciinema__poster-line">▶ Recording coming soon</p>
    <p class="asciinema__poster-title">{title}</p>
  </div>
  <figcaption>{title}</figcaption>
</figure>

<style>
  .asciinema {
    margin: 2rem 0;
  }

  .asciinema--empty .asciinema__poster {
    border: 1px dashed var(--border);
    border-radius: 8px;
    background-color: var(--card);
    padding: 2.5rem 1rem;
    text-align: center;
  }

  .asciinema__poster-line {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--fg);
  }

  .asciinema__poster-title {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }
</style>
